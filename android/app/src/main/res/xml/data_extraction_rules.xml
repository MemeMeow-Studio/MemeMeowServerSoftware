<?xml version="1.0" encoding="utf-8"?>
<!-- 云端备份和设备迁移均不复制本机凭据。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mememeow_credentials_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mememeow_credentials_v1.xml" />
    </device-transfer>
</data-extraction-rules>
